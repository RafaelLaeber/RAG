OPENAI_API_KEY=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Opcional: chave que assina os JWT de login (HS256). Sem ela, uma chave aleatória é
# gerada em storage/jwt_secret.key. Defina quando rodar mais de uma instância da API.
# Para gerar uma: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Opcional: liga o tracing no LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vega-agent
